# Supabase: Project Settings > API. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use the Supabase secret/service-role key only on the server.
SUPABASE_SERVICE_ROLE_KEY=
# UUID of the workspace created by the migration; required to mirror connections/audit logs.
SUPABASE_WORKSPACE_ID=

# Encryption key for connector credentials: 64 hex characters (32 bytes).
VAULT_KEY=

# Server-only key used to call OpenRouter. Never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
